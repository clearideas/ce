<h1>Hi, {{name}}!</h1>
<p class="intro-text">Please verify your email address to finish setting up Clear Ideas.</p>
<table class="body-action" align="center" width="100%" cellpadding="0" cellspacing="0">
  <tr>
    <td align="center">
      <a href="{{action_url}}" class="button" target="_blank">Verify email</a>
    </td>
  </tr>
</table>
<table class="body-sub">
  <tr>
    <td>
      <p class="sub">If the button does not work, copy and paste this URL into your browser.</p>
      <p class="sub">{{action_url}}</p>
    </td>
  </tr>
</table>
