<h1>Hi, {{name}}!</h1>
<p class="intro-text">
  {{invite_sender_name}} invited you to <strong>{{site_name}}</strong> on Clear Ideas.
</p>
<p>Open the invitation to sign in and join the site.</p>
<table class="body-action" align="center" width="100%" cellpadding="0" cellspacing="0">
  <tr>
    <td align="center">
      <a href="{{action_url}}" class="button" target="_blank">Open invitation</a>
    </td>
  </tr>
</table>
<p class="sub">This invitation link expires shortly. If you were not expecting this invite, you can ignore this email.</p>
