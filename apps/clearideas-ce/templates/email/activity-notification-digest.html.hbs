<h1>Hi, {{name}}!</h1>
<p class="intro-text">There was new activity in Clear Ideas.</p>
{{#each sites}}
  <h2>{{site_name}}</h2>
  <ul>
    {{#each notifications}}
      <li><strong>{{action}}</strong>: {{item_name}}</li>
    {{/each}}
  </ul>
  {{#if has_hidden}}
    <p>Plus {{hidden_count}} other updates.</p>
  {{/if}}
{{/each}}
{{#if has_hidden_sites}}
  <p>Plus updates from {{hidden_site_count}} other sites.</p>
{{/if}}
<table class="body-action" align="center" width="100%" cellpadding="0" cellspacing="0">
  <tr>
    <td align="center">
      <a href="{{action_url}}" class="button" target="_blank">Open Clear Ideas</a>
    </td>
  </tr>
</table>
