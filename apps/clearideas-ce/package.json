{
  "name": "@clearideas/ce",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm --prefix ../.. run build:contracts:core && npm --prefix ../../packages/clearideas-core run build && npm run build:web && tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "npm --prefix ../.. run build:contracts:core && npm --prefix ../../packages/clearideas-core run build && npm run build:web && tsc -p tsconfig.json",
    "build:web": "vite build",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "bootstrap": "tsx src/scripts/bootstrap.ts",
    "seed": "tsx src/scripts/seed.ts",
    "smoke": "tsx src/scripts/smoke.ts",
    "test": "npm run test:unit && npm run test:api && npm run test:web",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:api": "vitest run --config vitest.api.config.ts",
    "test:web": "vitest run --config vitest.web.config.ts",
    "test:e2e": "npm run build && playwright install chromium && playwright test --config playwright.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.coverage.config.ts && vitest run --coverage --config vitest.web.config.ts",
    "validate:routes": "node ../../scripts/validate-ce-routes.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.77",
    "@ai-sdk/mcp": "^1.0.42",
    "@ai-sdk/openai": "^3.0.63",
    "@ai-sdk/vue": "^3.0.182",
    "@clearideas/contracts-core": "file:../../packages/clearideas-contracts-core",
    "@clearideas/core": "file:../../packages/clearideas-core",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/vue-fontawesome": "^3.2.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vueuse/core": "^14.3.0",
    "@vueuse/integrations": "^14.3.0",
    "ai": "^6.0.182",
    "better-auth": "^1.6.27",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "8.5.1",
    "highlight.js": "^11.11.1",
    "luxon": "^3.7.2",
    "markdown-it": "^14.1.1",
    "minisearch": "^7.2.0",
    "mongoose": "^9.6.1",
    "nodemailer": "^9.0.5",
    "pdfjs-dist": "^6.2.108",
    "pinia": "^3.0.4",
    "pretty-bytes": "^7.1.0",
    "tippy.js": "^6.3.7",
    "vite": "^8.0.13",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7",
    "vue-tippy": "^6.7.1",
    "vue3-toastify": "^0.2.9",
    "vuetify": "^4.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^28.0.1",
    "@types/luxon": "^3.7.1",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-istanbul": "^4.1.5",
    "@vue/test-utils": "^2.4.10",
    "jsdom": "^29.1.1",
    "mongodb-memory-server": "^11.1.0",
    "sass-embedded": "^1.99.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.5"
  }
}
