{
  "printWidth": 110,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "avoid",
  "vueIndentScriptAndStyle": false,
  "overrides": [
    { "files": "*.md", "options": { "proseWrap": "preserve", "printWidth": 120 } },
    { "files": "*.{scss,css}", "options": { "singleQuote": false } }
  ]
}
