# Clear Ideas Community Edition

# Public URL users open in their browser. The local quickstart uses HTTP on localhost.
APP_URL=http://localhost:4100
CADDY_SITE=http://localhost:4100
CLEARIDEAS_CE_HOST_PORT=4100
HOST=0.0.0.0
PORT=4100
CLEARIDEAS_TRUST_PROXY=1
BETTER_AUTH_URL=http://localhost:4100
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret
FILE_ACCESS_TOKEN_SECRET=change-me-to-another-long-random-secret
HTTPS_REQUIRED=false

# MongoDB. Use either MONGODB_URI, or split Atlas-style variables.
# If you run docker-compose.local-mongo.yml, leave these blank; the override sets MONGODB_URI.
MONGODB_URI=
MONGODB_HOST=
MONGODB_DATABASE_NAME=clearideas_ce
MONGODB_AUTH_MECHANISM=
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_CERTIFICATE_BASE64=

FIRST_USER_EMAIL=admin@example.com
FIRST_USER_NAME=Clear Ideas Admin

STORAGE_ROOT=apps/clearideas-ce/data/storage
SEARCH_INDEX_ROOT=apps/clearideas-ce/data/search

EMAIL_PROVIDER=smtp
EMAIL_FROM="Clear Ideas <noreply@example.com>"
EMAIL_REPLY_TO=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=smtp-user
SMTP_PASS=smtp-password

AUTH_CODE_LENGTH=6
AUTH_CODE_EXPIRES_IN=600
AUTH_CODE_ALLOWED_ATTEMPTS=5

# Rate limiting. Defaults are suitable for small self-hosted deployments.
CLEARIDEAS_API_RATE_LIMIT_WINDOW_MS=900000
CLEARIDEAS_API_RATE_LIMIT_LIMIT=600
CLEARIDEAS_AUTH_RATE_LIMIT_WINDOW_MS=900000
CLEARIDEAS_AUTH_RATE_LIMIT_LIMIT=60
CLEARIDEAS_SPA_RATE_LIMIT_WINDOW_MS=300000
CLEARIDEAS_SPA_RATE_LIMIT_LIMIT=300
CLEARIDEAS_CORE_RATE_LIMIT_WINDOW_MS=900000
CLEARIDEAS_CORE_RATE_LIMIT_LIMIT=600
CLEARIDEAS_CHAT_RATE_LIMIT_WINDOW_MS=900000
CLEARIDEAS_CHAT_RATE_LIMIT_LIMIT=120
CLEARIDEAS_ANALYTICS_RATE_LIMIT_WINDOW_MS=900000
CLEARIDEAS_ANALYTICS_RATE_LIMIT_LIMIT=300
CLEARIDEAS_ACTIVITY_RATE_LIMIT_WINDOW_MS=900000
CLEARIDEAS_ACTIVITY_RATE_LIMIT_LIMIT=600

NOTIFICATIONS_ENABLED=true
NOTIFICATION_POLL_INTERVAL_MS=60000
CLEARIDEAS_DOCS_ENABLED=true

SEARCH_INDEX_IDLE_MS=300000
SEARCH_INDEX_MAX_LOADED_SITES=25
UPLOAD_SIGNING_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

AI_CHAT_MODEL=
AI_CHAT_MODELS=
CHAT_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
